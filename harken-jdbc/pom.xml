<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.harlanking</groupId>
        <artifactId>harken-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>harken-jdbc</artifactId>
    <name>Harken JDBC</name>
    <description>Affected-row limit, critical-table denylist and a transactional audit store. Plain JDBC, no Spring.</description>

    <dependencies>
        <dependency>
            <groupId>com.harlanking</groupId>
            <artifactId>harken-core</artifactId>
        </dependency>

        <!--
          测试用真实内存库。注意这只是 test scope：
          harken-jdbc 运行期只依赖 java.sql，不绑定任何数据库驱动。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>forbid-spring-in-jdbc</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- 与 core 同一条红线：JDBC 层也是框架无关的，Spring 用户靠 BeanPostProcessor 接进来 -->
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                    </excludes>
                                    <message>
                                        harken-jdbc 必须保持框架无关（只用 java.sql）。
                                        Spring 装配请放到 harken-spring-boot-starter。
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
