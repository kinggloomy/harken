<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.harlanking</groupId>
        <artifactId>harken-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>harken-spring-boot-starter</artifactId>
    <name>harken-spring-boot-starter</name>
    <description>Add one dependency, get a runtime console. Auto-configuration for Spring Boot 3.</description>

    <dependencies>
        <dependency>
            <groupId>com.harlanking</groupId>
            <artifactId>harken-spring</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- HTTP 层：servlet/filter 的注册靠它，没有 web 依赖的应用不引入 Boot Web 也能用 -->
        <dependency>
            <groupId>com.harlanking</groupId>
            <artifactId>harken-web</artifactId>
        </dependency>

        <!-- 数据保护：行数闸、表黑名单、数据库审计。只依赖 java.sql，不绑定数据库驱动 -->
        <dependency>
            <groupId>com.harlanking</groupId>
            <artifactId>harken-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- ServletRegistrationBean 在这个 artifact 里 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!--
          provided：注册 servlet 需要编译期认识 Servlet API，但运行期由容器提供。
          harken-web 的 provided 依赖不会传递过来，所以这里必须显式声明一次。
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta-servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- IDE 里给 application.yml 提供 harken.* 的补全，编译期不参与运行 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
